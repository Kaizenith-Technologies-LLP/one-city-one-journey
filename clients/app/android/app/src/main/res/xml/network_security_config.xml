<?xml version="1.0" encoding="utf-8"?>
<!--
  The demo API runs over plain HTTP on a LAN IP (e.g. http://192.168.1.70:4000/api)
  or the emulator host alias 10.0.2.2, so cleartext traffic is allowed.
  Map tiles (tile.openstreetmap.org) still use HTTPS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
